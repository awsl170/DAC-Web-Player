<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页没有封面时的占位。不能再用 @mipmap/ic_launcher：
     本工程只有 mipmap-anydpi-v26（自适应图标），API 26 以下取不到，5.1 的电视上一个 ImageView
     引用它就直接 InflateException 崩掉。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
        </shape>
    </item>
    <item android:gravity="center">
        <vector
            android:width="96dp"
            android:height="96dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:fillColor="?attr/colorOnSurfaceVariant"
                android:fillAlpha="0.5"
                android:pathData="M44,30 L44,62.5 A9,8.5 0 1,0 50,70 L50,42 L72,36 L72,56 A9,8.5 0 1,0 78,63.5 L78,28 Z" />
        </vector>
    </item>
</layer-list>
