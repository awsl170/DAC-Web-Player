<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="20dp">

    <!-- 顶部：返回 + 音质 + 下载 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/qualityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        tools:text="flac · 73.73MB · 高音质" />

    <TextView
        android:id="@+id/dacChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/qualityLabel"
        app:layout_constraintEnd_toStartOf="@id/btnDownload"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/qualityLabel"
        app:layout_constraintTop_toTopOf="@id/qualityLabel"
        tools:text="DAC 独占 · 44.1k · 24bit" />

    <ImageButton
        android:id="@+id/btnDownload"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/download"
        android:padding="12dp"
        android:src="@drawable/ic_download"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 封面 / 歌词 区域：竖屏时封面居中、歌词覆盖其上；电视等大屏（>=700dp 宽）时
         封面在左、歌词在右，由 PlayerActivity.applyWideArt() 切换约束。 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/artArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_cover_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CoverShape" />

    <ScrollView
        android:id="@+id/lyricsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fadingEdgeLength="48dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/lyricBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="96dp" />
    </ScrollView>

    <TextView
        android:id="@+id/lyricEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:text="@string/no_lyrics"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnLyricSearch"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/lyric_search"
        android:padding="8dp"
        android:src="@drawable/ic_search"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/btnLyrics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/lyrics"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurface"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/artArea"
        tools:text="生之泥壤" />

    <TextView
        android:id="@+id/artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="铁痕电台" />

    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.7"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/artist"
        tools:text="高音质 · flac · 73.73MB" />

    <!-- 进度 -->
    <TextView
        android:id="@+id/pos"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status"
        tools:text="0:00" />

    <TextView
        android:id="@+id/dur"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/pos"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="4:35" />

    <com.google.android.material.slider.Slider
        android:id="@+id/seek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:valueFrom="0"
        android:valueTo="1000"
        app:haloRadius="16dp"
        app:labelBehavior="gone"
        app:layout_constraintBottom_toBottomOf="@id/pos"
        app:layout_constraintEnd_toStartOf="@id/dur"
        app:layout_constraintStart_toEndOf="@id/pos"
        app:layout_constraintTop_toTopOf="@id/pos"
        app:thumbHeight="16dp"
        app:thumbWidth="16dp"
        app:tickVisible="false"
        app:trackHeight="3dp" />

    <!-- 主要控制：上一首 / 播放 / 下一首 -->
    <ImageButton
        android:id="@+id/btnPrev"
        android:layout_width="56dp"
        android:nextFocusDown="@id/btnShuffle"
        android:nextFocusRight="@id/btnPlay"
        android:nextFocusUp="@id/seek"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/previous"
        android:padding="12dp"
        android:src="@drawable/ic_skip_previous"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seek" />

    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="64dp"
        android:nextFocusDown="@id/btnQueue"
        android:nextFocusLeft="@id/btnPrev"
        android:nextFocusRight="@id/btnNext"
        android:nextFocusUp="@id/seek"
        android:layout_height="64dp"
        android:background="@drawable/bg_play_button"
        android:contentDescription="@string/play"
        android:padding="16dp"
        android:src="@drawable/ic_play"
        android:tint="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="@id/btnPrev"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnPrev" />

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="56dp"
        android:nextFocusDown="@id/btnRepeat"
        android:nextFocusLeft="@id/btnPlay"
        android:nextFocusUp="@id/seek"
        android:layout_height="56dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/next"
        android:padding="12dp"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="@id/btnPrev"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="@id/btnPrev" />

    <!-- 次要操作：随机 / 播放队列 / 均衡器 / 循环 -->
    <ImageButton
        android:id="@+id/btnShuffle"
        android:layout_marginBottom="@dimen/player_bottom_margin"
        android:nextFocusUp="@id/btnPrev"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/shuffle_off"
        android:padding="12dp"
        android:src="@drawable/ic_shuffle"
        app:layout_constraintEnd_toStartOf="@id/btnQueue"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintVertical_bias="1" />

    <ImageButton
        android:id="@+id/btnQueue"
        android:layout_marginBottom="@dimen/player_bottom_margin"
        android:nextFocusUp="@id/btnPlay"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/play_queue"
        android:padding="12dp"
        android:src="@drawable/ic_queue"
        app:layout_constraintEnd_toStartOf="@id/btnEq"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnShuffle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintVertical_bias="1" />

    <ImageButton
        android:id="@+id/btnEq"
        android:layout_marginBottom="@dimen/player_bottom_margin"
        android:nextFocusUp="@id/btnPlay"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/equalizer"
        android:padding="12dp"
        android:src="@drawable/ic_equalizer"
        app:layout_constraintEnd_toStartOf="@id/btnRepeat"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnQueue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintVertical_bias="1" />

    <ImageButton
        android:id="@+id/btnRepeat"
        android:layout_marginBottom="@dimen/player_bottom_margin"
        android:nextFocusUp="@id/btnNext"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_focus_round"
        android:contentDescription="@string/repeat_off"
        android:padding="12dp"
        android:src="@drawable/ic_repeat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnEq"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
